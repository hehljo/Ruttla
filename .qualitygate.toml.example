# Vorlage: nach .qualitygate.toml ins Projekt kopieren und anpassen.
# Ohne Profil laufen nur die universell sicheren Checks hart.

[gate]
strict = false

# exclude: Glob auf den RELATIVEN PFAD. Pfade mit Leerzeichen brauchen nichts
# Besonderes — "extracted/**" fängt auch "extracted/Some Vendor/web/index.html".
# Hier gehört entpacktes Fremdmaterial hinein: es ist nicht dein Code, und ein
# Check, der tausendfach darüber meldet, deckt die echten Befunde zu.
# .gitignore wird bewusst NICHT gelesen — "nicht versioniert" und "nicht
# prüfenswert" sind zwei verschiedene Fragen.
exclude = ["legacy/**", "vendor/**", "**/*.generated.ts", "extracted/**"]

# exclude_dirs: nur der VERZEICHNISNAME, auf jeder Ebene. Schneidet den Ast
# beim Durchlaufen ab — schneller als ein Glob bei großen Bäumen.
exclude_dirs = []

[brand]
# Ohne Angabe wird der Name aus package.json / project.godot abgeleitet.
names = []
# Dateien, in denen der Markenname stehen DARF (die Einzelquelle).
sources = []

[severity]
# "error" | "warning" | "info" | "off" — Präfix mit * möglich.
"secrets.*" = "error"
